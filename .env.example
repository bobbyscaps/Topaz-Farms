# Epoch Acres environment (all optional)

# Enable the WalletConnect connector. Get a project id at https://cloud.reown.com
# When unset, WalletConnect is shown but disabled (Demo Farmer + injected still work).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Override the proxied upstreams (defaults shown). Used by next.config.ts rewrites.
# TOPAZ_STATS_UPSTREAM=https://www.topazdex.com
# BSC_RPC_UPSTREAM=https://bsc-dataseed.bnbchain.org
